            </rdf:Bag>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">Xilinx DS827 LogiCORE IP AXI to AHB-Lite Bridge (v1.01a), Data Sheet</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
