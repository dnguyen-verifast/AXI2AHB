      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>The AXI to AHB-Lite Bridge translates AXI4 transactions into AHB-Lite transactions. It functions as a slave on the AXI4 interface and as a master on the AHB-Lite interface. The AXI to AHB-Lite Bridge main use model is to connect the AHB-Lite slaves with AXI masters.</rdf:li>
               <rdf:li>ds827,827,Spartan,Virtex,IP,Xilinx,AXI,AXI-Lite,AMBA,Kintex-7, K7, Artix, Artix-7, A7, V6, Virtex-6, Spartan-6, V6, S6, V7, Virtex-7</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">The AXI to AHB-Lite Bridge translates AXI4 transactions into AHB-Lite transactions. It functions as a slave on the AXI4 interface and as a master on the AHB-Lite interface. The AXI to AHB-Lite Bridge main use model is to connect the AHB-Lite slaves with AXI masters.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:modified>2013-03-10T16:38:43.1-07:00</dc:modified>
